{
  // SELIC-15 · Cloudflare Worker (página + API) com banco D1
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selic-15",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // Página, imagens e biblioteca de Excel embutidas no Worker
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/exceljs.min.js"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "selic-15", "database_id": "211013d8-9321-4f88-bcbe-c68fd47218c7" }],
  // Fotografia diária dos indicadores às 23h50 (horário de Brasília)
  "triggers": { "crons": ["50 2 * * *"] },
  "observability": { "enabled": true },
  // Preenchidos depois de ativar o Cloudflare Access (ver README). Vazios = sistema bloqueado.
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}
