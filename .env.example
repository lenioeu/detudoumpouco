# Critério de publicação
MIN_DISCOUNT_PCT=5
MAX_POSTS_PER_CYCLE=3
CRON_SCHEDULE=0 */2 * * *
# Marcas grandes separadas por vírgula (nome exatamente como a Lomadee usa em
# /affiliate/brands). Dentro da mesma faixa de desconto (±15 pontos), essas
# entram na frente de lojas pequenas/desconhecidas.
MAIN_STORES=Shopee,Mobly,Dyson,Xiaomi Brasil,Lenovo,Shein,Disney,iRobot,Prime Video,Tiktok,Malwee,Friopeças,Itatiaia,Gazin,Camisaria Colombo,Hunter Fan,NutriBullet,Coza,Brinox,Rovitex,BALAROTI

# Mercado Livre (developers.mercadolivre.com.br > Minhas aplicações)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REFRESH_TOKEN=
# termos de busca separados por vírgula, ex: notebook,smartphone,fone de ouvido
MERCADOLIVRE_QUERIES=

# Awin (ui.awin.com > Toolbox > API Credentials)
AWIN_PUBLISHER_ID=
AWIN_ACCESS_TOKEN=
AWIN_LOCALE=pt_BR
# IDs de anunciante aprovados, separados por vírgula; "id:Nome" para rotular a loja
# ex: 1234:Americanas,5678:Kabum
AWIN_ADVERTISERS=

# Site (promozap.app) — opcional, avisa o Worker a cada achado publicado
SITE_API_URL=https://promozap.app/api/achados
SITE_API_SECRET=

# Lomadee (painel da conta > Credenciais de API; escopos products:read, shortener:write e brands:read)
LOMADEE_API_KEY=
# termo de busca opcional pra filtrar o catálogo, ex: "smartphone"
LOMADEE_SEARCH=

# Espelhamento de grupos do WhatsApp (opcional) — roda junto do daemon.
# JIDs de grupos separados por vírgula (ex: 120363012345678901@g.us).
# Descubra os JIDs com: npm run list-groups
MIRROR_GROUP_JIDS=

# Espelhamento de canais/grupos do Telegram (opcional) — roda junto do daemon.
# Pegue API_ID e API_HASH em my.telegram.org (grátis, login com seu número).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# @usuário dos canais/grupos, separados por vírgula, ex: pelando,promocaonaveia
TELEGRAM_CHANNELS=
