# Copie para .env e preencha. Detalhes de cada item no README.

PORT=3000
PUBLIC_URL=https://bot.seudominio.com.br
DATABASE_PATH=data/assinabot.db

# Números (com DDI e DDD, só dígitos) que podem enviar documentos. Separe vários por vírgula.
AUTHORIZED_SENDERS=5551999998888
# Como o escritório aparece para quem vai assinar e no manifesto
SENDER_DISPLAY_NAME=Escritório Exemplo Advocacia
SENDER_LOCATION=Porto Alegre/RS

# Certificado que assina digitalmente a via final. Se o arquivo não existir,
# um certificado autoassinado é criado nele com esta senha na primeira execução.
# Para usar o A1 (ICP-Brasil) do escritório, aponte para o .p12/.pfx e informe a senha dele.
CERTIFICATE_PATH=data/certificado.p12
CERTIFICATE_PASSWORD=

# WhatsApp Business Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Invente uma senha qualquer e use a mesma ao cadastrar o webhook na Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_SOLICITACAO=solicitacao_assinatura
WHATSAPP_TEMPLATE_AVISO=aviso_assinatura
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Claude (leitura do documento)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
