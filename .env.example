# Copie para .env e preencha. Detalhes de cada item no README.

PORT=3000
PUBLIC_URL=https://bot.seudominio.com.br
DATABASE_PATH=data/assinabot.db

# Números (com DDI e DDD, só dígitos) que podem enviar documentos. Separe vários por vírgula.
AUTHORIZED_SENDERS=5551999998888
# Como o escritório aparece na mensagem para quem vai assinar
SENDER_DISPLAY_NAME=Escritório Exemplo Advocacia

# WhatsApp Business Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Invente uma senha qualquer e use a mesma ao cadastrar o webhook na Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_SOLICITACAO=solicitacao_assinatura
WHATSAPP_TEMPLATE_AVISO=aviso_assinatura
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Documenso (seu servidor)
DOCUMENSO_URL=https://assinar.seudominio.com.br
DOCUMENSO_API_TOKEN=
DOCUMENSO_WEBHOOK_SECRET=
SIGNER_PLACEHOLDER_EMAIL_DOMAIN=whatsapp.invalid

# Claude (leitura do documento)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
