{
  // O Worker serve a própria página (worker/site.generated.js, gerado do build do
  // Astro) e a API em /api/*. Nada de upload de assets separado.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "promozap",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "ACHADOS",
      "database_name": "promozap-achados",
      "database_id": "dd9ccb8d-44f9-4c2b-82d6-dcdf36bad617"
    }
  ]
}
