{
  // O Cloudflare serve os arquivos gerados em ./dist. O código em worker/ só roda em /api/*
  // (lista e recebe os achados que o bot publica no Canal do WhatsApp).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "promozap",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "ACHADOS",
      "database_name": "promozap-achados",
      "database_id": "PREENCHER_APOS_CRIAR_O_D1"
    }
  ]
}
