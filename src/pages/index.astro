---
import Base from '../layouts/Base.astro';
import Bloco from '../components/Bloco.astro';
import { SITE } from '../config';
import { ferramenta, prontas, secaoPorSlug, secoesAtivas } from '../data';
import { DESTAQUES } from '../data/destaques';

const blocos = DESTAQUES.flatMap((d) => {
  if (d.tipo === 'secao') {
    const s = secaoPorSlug(d.slug);
    const n = prontas(d.slug).length;
    return s && n ? [{ href: `/${s.slug}`, icone: s.slug, nome: d.nome ?? s.nome, descricao: d.descricao, selo: `${n} ${n === 1 ? 'ferramenta' : 'ferramentas'}` }] : [];
  }
  const f = ferramenta(d.secao, d.slug);
  return f && f.status === 'pronta'
    ? [{ href: f.url, icone: d.icone, nome: f.nome, descricao: d.descricao, selo: 'Mais usada', vt: `vt-${f.secao}-${f.slug}` }]
    : [];
});
const secoes = secoesAtivas();
const total = prontas().length;
---
<Base titulo={SITE.slogan} descricao={SITE.descricao}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.nome, url: SITE.url, inLanguage: 'pt-BR' }]}>
  <section class="hero">
    <div class="bolhas" aria-hidden="true"><span></span><span></span></div>
    <div class="container conteudo">
      <h1>Ferramentas grátis que resolvem na hora</h1>
      <p class="sub">{total} ferramentas para o dia a dia. Sem cadastro, sem instalar nada, e seus arquivos não saem do seu aparelho.</p>
    </div>
  </section>

  <div class="container corpo">
    <ul class="grade" aria-label="Ferramentas e categorias">
      {blocos.map((b) => <li><Bloco {...b} /></li>)}
    </ul>

    <section class="todas" aria-labelledby="todas-titulo">
      <h2 id="todas-titulo">Todas as ferramentas</h2>
      <div class="colunas">
        {secoes.map((s) => (
          <div class="coluna">
            <h3><a href={`/${s.slug}`}>{s.nome}</a></h3>
            <ul>{prontas(s.slug).map((f) => <li><a href={f.url}>{f.nome}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .hero { position: relative; overflow: hidden; background: var(--brand); color: var(--brand-ink); padding-block: clamp(32px, 6vw, 56px) clamp(72px, 9vw, 104px); }
  .conteudo { position: relative; display: flex; flex-direction: column; gap: 14px; }
  .hero h1 { max-width: 18ch; font-size: clamp(2rem, 5vw, 3rem); }
  .sub { font-size: 1.1rem; max-width: 56ch; }
  .bolhas span { position: absolute; border-radius: 50%; background: #fff; opacity: 0.18; animation: flutuar 14s ease-in-out infinite alternate; }
  .bolhas span:nth-child(1) { width: 380px; height: 380px; right: -90px; top: -140px; }
  .bolhas span:nth-child(2) { width: 160px; height: 160px; right: 24%; bottom: -70px; animation-duration: 18s; opacity: 0.12; }
  @keyframes flutuar { to { transform: translate(-30px, 24px) scale(1.06); } }

  .corpo { display: flex; flex-direction: column; gap: 56px; }
  /* Os blocos sobem por cima da faixa amarela. */
  .grade {
    list-style: none; margin: clamp(-64px, -6vw, -44px) 0 0; padding: 0; position: relative;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 16px;
  }
  .grade li { min-width: 0; }
  @media (max-width: 560px) { .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } }

  .todas { display: flex; flex-direction: column; gap: 18px; }
  .todas h2 { font-size: 1.35rem; }
  .colunas { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 24px 20px; }
  .coluna h3 { font-size: 1rem; margin-bottom: 8px; }
  .coluna h3 a { color: var(--fg); text-decoration: none; }
  .coluna h3 a:hover { text-decoration: underline; text-decoration-color: var(--brand); text-decoration-thickness: 3px; }
  .coluna ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 0.95rem; }
  .coluna li a { color: var(--muted); text-decoration: none; }
  .coluna li a:hover { color: var(--fg); text-decoration: underline; }
</style>
