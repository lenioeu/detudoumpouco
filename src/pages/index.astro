---
import Base from '../layouts/Base.astro';
import CartaoFerramenta from '../components/CartaoFerramenta.astro';
import Icone from '../components/Icone.astro';
import { SITE } from '../config';
import { prontas, secoesAtivas } from '../data';
const secoes = secoesAtivas();
---
<Base titulo={SITE.slogan} descricao={SITE.descricao}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.nome, url: SITE.url, inLanguage: 'pt-BR' }]}>
  <section class="hero">
    <div class="bolhas" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container conteudo">
      <h1>Quebrou o galho.<br />Ferramentas grátis que resolvem na hora.</h1>
      <p class="sub">Calculadoras, conversores e ferramentas de PDF, imagem, vídeo e áudio. Sem cadastro, sem instalar nada, e seus arquivos não saem do seu aparelho.</p>
      <label class="busca">
        <Icone nome="busca" tamanho={22} />
        <span class="sr">Buscar ferramenta</span>
        <input id="busca" type="search" placeholder="O que você precisa fazer?" autocomplete="off" />
      </label>
    </div>
    <svg class="onda" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V22C240 52 480 60 720 40S1200 0 1440 18V60z" /></svg>
  </section>

  <div class="container secoes">
    {secoes.map((s) => (
      <section class="secao" data-secao>
        <div class="titulo-secao">
          <h2><a href={`/${s.slug}`}><Icone nome={s.slug} />{s.nome}</a></h2>
          <span class="muted">{s.resumo}</span>
        </div>
        <ul>{prontas(s.slug).map((f) => <li><CartaoFerramenta f={f} /></li>)}</ul>
      </section>
    ))}
    <p id="nada" class="muted" hidden>Nenhuma ferramenta encontrada. Tente outra palavra.</p>
  </div>
</Base>

<script>
  const campo = document.getElementById('busca') as HTMLInputElement;
  const secoes = document.querySelectorAll<HTMLElement>('[data-secao]');
  const nada = document.getElementById('nada')!;
  const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  campo.addEventListener('input', () => {
    const q = norm(campo.value.trim());
    let total = 0;
    secoes.forEach((s) => {
      let n = 0;
      s.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const ok = !q || norm(li.querySelector('a')!.dataset.busca!).includes(q);
        li.hidden = !ok; if (ok) n++;
      });
      s.hidden = n === 0; total += n;
    });
    nada.hidden = total > 0;
  });
</script>

<style>
  .hero { position: relative; overflow: hidden; background: var(--brand); color: var(--brand-ink); padding-block: clamp(36px, 7vw, 72px) clamp(56px, 8vw, 88px); }
  .conteudo { position: relative; display: flex; flex-direction: column; gap: 18px; }
  .hero h1 { max-width: 20ch; font-size: clamp(2rem, 5.2vw, 3.2rem); }
  .sub { font-size: 1.1rem; max-width: 58ch; }
  .busca {
    display: flex; align-items: center; gap: 10px; max-width: 560px; margin-top: 6px;
    background: #fff; color: #16181d; border: 2px solid var(--brand-ink); border-radius: 14px; padding: 4px 6px 4px 14px;
    box-shadow: 0 4px 0 var(--brand-ink); transition: transform 0.2s var(--mola), box-shadow 0.2s var(--suave);
  }
  .busca:focus-within { transform: translateY(-2px); box-shadow: 0 6px 0 var(--brand-ink); }
  .busca input { border: 0; box-shadow: none !important; background: transparent; color: #16181d; padding: 12px 8px; font-size: 1.05rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .onda { position: absolute; left: 0; bottom: -1px; width: 100%; height: 40px; fill: var(--bg); }

  /* Formas de fundo que flutuam devagar (só transform: custo quase zero) */
  .bolhas span { position: absolute; border-radius: 50%; background: #fff; opacity: 0.18; animation: flutuar 14s ease-in-out infinite alternate; }
  .bolhas span:nth-child(1) { width: 380px; height: 380px; right: -90px; top: -120px; }
  .bolhas span:nth-child(2) { width: 180px; height: 180px; right: 22%; bottom: -60px; animation-duration: 18s; opacity: 0.12; }
  .bolhas span:nth-child(3) { width: 90px; height: 90px; right: 12%; top: 46%; animation-duration: 11s; background: var(--brand-ink); opacity: 0.08; }
  @keyframes flutuar { to { transform: translate(-30px, 24px) scale(1.06); } }

  .secoes { display: flex; flex-direction: column; gap: 44px; padding-block: 28px 0; }
  .secao { display: flex; flex-direction: column; gap: 14px; }
  .titulo-secao { display: flex; align-items: baseline; gap: 6px 14px; flex-wrap: wrap; }
  .titulo-secao a { display: inline-flex; align-items: center; gap: 10px; color: var(--fg); text-decoration: none; }
  .titulo-secao a:hover { text-decoration: underline; text-decoration-color: var(--brand); text-decoration-thickness: 3px; text-underline-offset: 4px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
</style>
