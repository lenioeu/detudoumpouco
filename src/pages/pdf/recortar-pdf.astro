---
import Ferramenta from '../../layouts/Ferramenta.astro';
import SoltarArquivos from '../../components/SoltarArquivos.astro';
---
<Ferramenta
  secao="pdf"
  slug="recortar-pdf"
  titulo="Recortar PDF"
  subtitulo="Corte as margens das páginas do PDF: arraste a área que deve ficar ou deixe a ferramenta achar as margens brancas sozinha. Tudo no seu navegador, sem enviar o arquivo."
  tituloSeo="Recortar PDF online grátis: cortar margens sem enviar"
  descricao="Recorte as margens do PDF grátis: arraste a área na prévia, digite as margens em mm ou corte as bordas brancas sozinho. O arquivo não sai do seu aparelho."
  passos={[
    'Escolha o PDF ou arraste o arquivo para a área indicada.',
    'Arraste os cantos do retângulo na prévia até ficar só a parte que interessa, ou digite as margens em milímetros.',
    'Se preferir, escolha "Margens brancas automáticas": cada página é cortada rente ao conteúdo, com a folga que você escolher.',
    'Confira as páginas nas miniaturas. Para cortar só algumas, digite os números em "Páginas".',
    'Clique em "Recortar PDF" e baixe o arquivo pronto.',
  ]}
  perguntas={[
    { p: 'Como cortar as margens de um PDF?', r: 'Escolha o PDF e arraste os cantos do retângulo amarelo na prévia até ficar só o que interessa. O mesmo corte vale para todas as páginas. Se as margens brancas variam de página para página, use "Margens brancas automáticas".' },
    { p: 'Como recortar só uma página do PDF?', r: 'Em "Páginas", digite o número dela (por exemplo, 3). As outras páginas ficam como estão. Para cortar e ainda separar essa página num arquivo próprio, recorte aqui e depois use o Dividir PDF.' },
    { p: 'O que foi cortado some do arquivo?', r: 'Não. O recorte esconde a parte de fora, como uma moldura, e o PDF fica menor na tela e na impressão. Mas o conteúdo continua dentro do arquivo, e um editor de PDF consegue mostrar de novo. Por isso, não use o recorte para esconder dados pessoais ou sigilosos.' },
    { p: 'Recortar diminui o tamanho do arquivo?', r: 'Quase nada, justamente porque o conteúdo de fora continua no arquivo. Para um PDF mais leve, use o Comprimir PDF depois de recortar.' },
    { p: 'O texto continua selecionável depois do recorte?', r: 'Sim. A página não vira imagem: textos, links e a qualidade das imagens ficam iguais. Só muda a parte da página que aparece.' },
    { p: 'Meu PDF é enviado para algum servidor?', r: 'Não. O recorte é feito no seu navegador e o arquivo não sai do aparelho.' },
  ]}
>
  <div class="stack">
    <SoltarArquivos id="entrada" accept="application/pdf,.pdf" texto="Escolher PDF" />
    <p id="aviso" class="erro" role="alert" hidden></p>

    <div id="painel" class="stack" hidden>
      <p id="info" class="muted"></p>

      <fieldset class="pilulas">
        <legend class="rotulo">Como cortar</legend>
        <label><input type="radio" name="modo" value="manual" checked /> <span>Escolher a área</span></label>
        <label><input type="radio" name="modo" value="auto" /> <span>Margens brancas automáticas</span></label>
      </fieldset>

      <div class="editor">
        <div class="previa-area">
          <div class="palco" id="palco">
            <div id="tela" class="tela"><span class="muted">Carregando a prévia…</span></div>
            <div id="caixa" class="caixa" data-alca="mover" tabindex="0" role="group" hidden
                 aria-label="Área que fica. Use as setas para mover e Shift com as setas para mudar o tamanho.">
              <span class="alca" data-alca="no" aria-hidden="true"></span>
              <span class="alca" data-alca="ne" aria-hidden="true"></span>
              <span class="alca" data-alca="so" aria-hidden="true"></span>
              <span class="alca" data-alca="se" aria-hidden="true"></span>
            </div>
          </div>
          <div class="navegar">
            <button id="anterior" type="button" class="btn btn-sec" aria-label="Página anterior">‹</button>
            <span id="qual" class="muted" aria-live="polite"></span>
            <button id="proxima" type="button" class="btn btn-sec" aria-label="Próxima página">›</button>
          </div>
        </div>

        <div class="opcoes stack">
          <div id="campos-manual" class="stack">
            <div class="margens">
              <div class="campo"><label for="m-topo">Em cima (mm)</label><input id="m-topo" type="number" min="0" step="0.5" value="0" inputmode="decimal" /></div>
              <div class="campo"><label for="m-base">Embaixo (mm)</label><input id="m-base" type="number" min="0" step="0.5" value="0" inputmode="decimal" /></div>
              <div class="campo"><label for="m-esquerda">Esquerda (mm)</label><input id="m-esquerda" type="number" min="0" step="0.5" value="0" inputmode="decimal" /></div>
              <div class="campo"><label for="m-direita">Direita (mm)</label><input id="m-direita" type="number" min="0" step="0.5" value="0" inputmode="decimal" /></div>
            </div>
            <div class="botoes">
              <button id="detectar" type="button" class="btn btn-sec">Achar as margens brancas desta página</button>
              <button id="inteira" type="button" class="btn btn-sec">Página inteira</button>
            </div>
            <small class="muted">As mesmas margens valem para todas as páginas escolhidas.</small>
          </div>

          <div id="campos-auto" class="stack" hidden>
            <div class="campo">
              <label for="folga">Folga em volta do conteúdo (mm)</label>
              <input id="folga" type="number" min="0" max="50" step="1" value="5" inputmode="numeric" />
              <small>Cada página é cortada rente ao que está escrito ou desenhado nela, mais esta folga.</small>
            </div>
          </div>

          <div class="campo">
            <label for="paginas">Páginas</label>
            <input id="paginas" type="text" placeholder="Todas" autocomplete="off" />
            <small>Deixe vazio para todas, ou digite como 1-3, 5.</small>
          </div>
          <p id="resumo" class="muted" aria-live="polite"></p>
        </div>
      </div>

      <ol id="miniaturas" class="miniaturas" aria-label="Páginas do PDF"></ol>

      <div class="enviar">
        <button id="recortar" type="button" class="btn" disabled>Recortar PDF</button>
        <span id="status" class="muted" aria-live="polite"></span>
      </div>
    </div>

    <div id="saida" class="resultado saida" hidden>
      <div><strong>PDF recortado</strong><span id="saida-info" class="muted"></span></div>
      <a id="baixar" class="btn" href="#" download>Baixar PDF</a>
    </div>
  </div>

  <Fragment slot="texto">
    <h2>Quando vale a pena recortar</h2>
    <p>Muita gente recorta PDF para ler no celular. Um livro escaneado ou um artigo com margens largas fica com a letra miúda na tela pequena; tirando as bordas brancas, o texto ocupa a tela toda e dá para ler sem ficar dando zoom. Outros usos comuns: tirar a faixa preta que o scanner deixa na beira da folha, cortar a marca de uma régua ou de um dedo que apareceu na digitalização, deixar só a etiqueta de envio de uma página A4 para imprimir em impressora térmica, ou aproveitar só o gráfico de um relatório para colar numa apresentação.</p>
    <h2>Escolher a área ou cortar sozinho</h2>
    <ul>
      <li><strong>Escolher a área:</strong> você arrasta o retângulo ou digita as margens em milímetros, e o mesmo corte vale para todas as páginas escolhidas. É o melhor quando o documento tem o mesmo layout em tudo, como uma apostila ou uma série de boletos.</li>
      <li><strong>Margens brancas automáticas:</strong> cada página é analisada e cortada rente ao conteúdo, com uma folga em volta. Serve para escaneamentos tortos, em que cada página ficou num lugar, e para slides exportados com bordas grandes. Páginas totalmente em branco ficam como estão.</li>
    </ul>
    <h2>O que você precisa saber</h2>
    <p>O recorte funciona como uma moldura: a parte de fora deixa de aparecer na tela e na impressão, e a página fica do tamanho novo. Mas o conteúdo cortado continua dentro do arquivo. Isso é bom porque nada se perde e o texto continua selecionável, mas significa que recortar não serve para esconder um número de documento ou uma assinatura. Também por isso o arquivo quase não diminui; se precisar de um PDF mais leve, passe ele no <a href="/pdf/comprimir-pdf">Comprimir PDF</a>. Se o objetivo é imprimir o recorte numa folha A4 inteira, use depois o <a href="/pdf/ajustar-a4">Ajustar PDF para A4</a>, que amplia cada página para ocupar a folha.</p>
  </Fragment>
</Ferramenta>

<script>
  import { tamanho as tamanhoArquivo } from '../../lib/arquivos';
  import { abrirParaEditar, abrirParaVer, desenharPagina, fecharPdf, miniatura, filaDeTrabalho, paraBlob, ErroPdf, type DocumentoPdfJs } from '../../lib/pdf-navegador';
  import { infoDaPagina, type InfoPagina } from '../../lib/pdf-desenho';
  import { arrastarRecorte, type Alca, type Retangulo } from '../../lib/imagem';
  import { lerIntervalos } from '../../lib/intervalos';
  import { MINIMO_PT, limitesDoConteudo, limitesEmPontos, margensParaRecorte, paraCaixaPdf, recorteParaMargens, type Margens } from '../../lib/recortar-pdf';
  import { mmParaPt, ptParaMm } from '../../lib/pdf-visual';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const entrada = $('entrada');
  const aviso = $('aviso');
  const painel = $('painel');
  const info = $('info');
  const palco = $('palco');
  const tela = $('tela');
  const caixa = $('caixa');
  const qual = $('qual');
  const anterior = $<HTMLButtonElement>('anterior');
  const proxima = $<HTMLButtonElement>('proxima');
  const camposManual = $('campos-manual');
  const camposAuto = $('campos-auto');
  const campos = {
    topo: $<HTMLInputElement>('m-topo'),
    base: $<HTMLInputElement>('m-base'),
    esquerda: $<HTMLInputElement>('m-esquerda'),
    direita: $<HTMLInputElement>('m-direita'),
  };
  const folga = $<HTMLInputElement>('folga');
  const paginasCampo = $<HTMLInputElement>('paginas');
  const resumo = $('resumo');
  const grade = $('miniaturas');
  const botao = $<HTMLButtonElement>('recortar');
  const status = $('status');
  const saida = $('saida');
  const baixar = $<HTMLAnchorElement>('baixar');

  let dados: ArrayBuffer | null = null;
  let visor: DocumentoPdfJs | null = null;
  let infos: InfoPagina[] = [];
  let nomeBase = 'documento';
  let atual = 1;
  let rodada = 0;
  let url = '';
  let fila = filaDeTrabalho();
  let observador: IntersectionObserver | null = null;
  let margens: Margens = { topo: 0, base: 0, esquerda: 0, direita: 0 };
  /** Resultado da análise de margens brancas de cada página (em pontos, sem folga); null = em branco. */
  const analises = new Map<number, Retangulo | null>();

  const modo = () => document.querySelector<HTMLInputElement>('input[name="modo"]:checked')!.value as 'manual' | 'auto';
  const folgaPt = () => mmParaPt(Math.min(50, Math.max(0, Number(folga.value) || 0)));

  function paginasEscolhidas(): { paginas: number[]; erro?: string } {
    const n = infos.length;
    if (!paginasCampo.value.trim()) return { paginas: Array.from({ length: n }, (_, i) => i + 1) };
    const r = lerIntervalos(paginasCampo.value, n);
    if (r.erro) return { paginas: [], erro: r.erro };
    return { paginas: [...new Set(r.grupos.flat())].sort((a, b) => a - b) };
  }

  function comFolga(r: Retangulo, f: number, inf: InfoPagina): Retangulo {
    const x = Math.max(0, r.x - f), y = Math.max(0, r.y - f);
    const x1 = Math.min(inf.largura, r.x + r.largura + f), y1 = Math.min(inf.altura, r.y + r.altura + f);
    return { x, y, largura: x1 - x, altura: y1 - y };
  }

  /** A área que fica numa página. undefined = ainda não analisada; null = não dá para cortar. */
  function recorteDaPagina(p: number): Retangulo | null | undefined {
    const inf = infos[p - 1];
    if (modo() === 'auto') {
      if (!analises.has(p)) return undefined;
      const a = analises.get(p);
      return a ? comFolga(a, folgaPt(), inf) : null;
    }
    return margensParaRecorte(margens, inf.largura, inf.altura);
  }

  /** Desenha a página e procura o conteúdo (tudo o que não é quase branco). */
  async function analisar(p: number): Promise<Retangulo | null> {
    if (analises.has(p)) return analises.get(p)!;
    const inf = infos[p - 1];
    const { canvas } = await desenharPagina(visor!, p, Math.min(1.5, 900 / Math.max(inf.largura, inf.altura)));
    const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    const px = limitesDoConteudo(ctx.getImageData(0, 0, canvas.width, canvas.height).data, canvas.width, canvas.height);
    const r = px ? limitesEmPontos(px, canvas.width / inf.largura, 0, inf.largura, inf.altura) : null;
    analises.set(p, r);
    return r;
  }

  // ---- Prévia e moldura de corte ----
  let base: { pagina: number; canvas: HTMLCanvasElement } | null = null;

  function posicionar(el: HTMLElement, r: Retangulo, inf: InfoPagina) {
    el.style.left = `${(r.x / inf.largura) * 100}%`;
    el.style.top = `${(r.y / inf.altura) * 100}%`;
    el.style.width = `${(r.largura / inf.largura) * 100}%`;
    el.style.height = `${(r.altura / inf.altura) * 100}%`;
  }

  function desenharCaixa() {
    const inf = infos[atual - 1];
    if (!inf || !base) { caixa.hidden = true; return; }
    const r = recorteDaPagina(atual);
    const escolhida = paginasEscolhidas().paginas.includes(atual);
    caixa.hidden = !r;
    caixa.classList.toggle('fixa', modo() === 'auto');
    caixa.classList.toggle('fora', !escolhida);
    if (r) posicionar(caixa, r, inf);
  }

  async function desenharPrevia() {
    if (!visor || !infos.length) return;
    const minha = rodada, pagina = atual;
    qual.textContent = `Página ${pagina} de ${infos.length}`;
    anterior.disabled = pagina <= 1;
    proxima.disabled = pagina >= infos.length;
    marcarMiniatura();
    const inf = infos[pagina - 1];
    if (!base || base.pagina !== pagina) {
      const larguraCss = Math.min(palco.parentElement!.clientWidth || 360, 480);
      const densidade = Math.min(window.devicePixelRatio || 1, 2);
      const { canvas } = await desenharPagina(visor, pagina, (larguraCss * densidade) / inf.largura);
      if (minha !== rodada || pagina !== atual) return;
      canvas.setAttribute('role', 'img');
      canvas.setAttribute('aria-label', `Prévia da página ${pagina}`);
      base = { pagina, canvas };
      tela.replaceChildren(canvas);
    }
    if (modo() === 'auto' && !analises.has(pagina)) {
      await fila(() => analisar(pagina));
      if (minha !== rodada || pagina !== atual) return;
      atualizarMiniaturas();
      atualizarResumo();
    }
    desenharCaixa();
  }

  function irPara(p: number) {
    if (p < 1 || p > infos.length) return;
    atual = p;
    desenharPrevia().catch(() => undefined);
  }

  // ---- Miniaturas ----
  function montarMiniaturas() {
    observador?.disconnect();
    grade.innerHTML = '';
    const minha = rodada;
    observador = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting || !visor) continue;
        observador!.unobserve(e.target);
        const li = e.target as HTMLElement;
        const n = Number(li.dataset.pagina);
        fila(async () => {
          if (minha !== rodada || !visor) return;
          const c = await miniatura(visor, n, 110);
          if (minha === rodada) li.querySelector('.mini')!.prepend(c);
        }).catch(() => undefined);
      }
    }, { rootMargin: '300px 0px' });
    infos.forEach((inf, i) => {
      const p = i + 1;
      const li = document.createElement('li');
      li.dataset.pagina = String(p);
      li.innerHTML = `<button type="button" aria-label="Ver a página ${p}"><span class="mini" style="aspect-ratio:${inf.largura}/${inf.altura}"><span class="corte" hidden></span></span><span class="num">${p}</span></button>`;
      grade.append(li);
      observador!.observe(li);
    });
    atualizarMiniaturas();
  }

  function atualizarMiniaturas() {
    const escolhidas = new Set(paginasEscolhidas().paginas);
    for (const li of Array.from(grade.children) as HTMLElement[]) {
      const p = Number(li.dataset.pagina);
      const corte = li.querySelector<HTMLElement>('.corte')!;
      const r = recorteDaPagina(p);
      li.classList.toggle('fora', !escolhidas.has(p));
      corte.hidden = !r || !escolhidas.has(p);
      if (r) posicionar(corte, r, infos[p - 1]);
    }
  }

  function marcarMiniatura() {
    for (const li of Array.from(grade.children) as HTMLElement[]) li.classList.toggle('atual', Number(li.dataset.pagina) === atual);
  }

  // ---- Campos ----
  function mostrarMargens() {
    for (const [k, el] of Object.entries(campos) as [keyof Margens, HTMLInputElement][]) {
      if (document.activeElement !== el) el.value = String(margens[k]);
    }
  }

  function atualizarResumo() {
    const sel = paginasEscolhidas();
    let msg: string, erro = false;
    if (sel.erro) { msg = sel.erro; erro = true; }
    else if (modo() === 'manual') {
      const inf = infos[atual - 1];
      const r = margensParaRecorte(margens, inf.largura, inf.altura);
      if (!r) { msg = 'As margens são maiores que a página. Diminua os valores.'; erro = true; }
      else {
        const pequenas = sel.paginas.filter((p) => !margensParaRecorte(margens, infos[p - 1].largura, infos[p - 1].altura)).length;
        const semCorte = margens.topo + margens.base + margens.esquerda + margens.direita === 0;
        msg = semCorte ? 'Arraste os cantos do retângulo ou digite as margens.'
          : `A página fica com ${fmt(ptParaMm(r.largura) / 10)} x ${fmt(ptParaMm(r.altura) / 10)} cm. Vai cortar ${sel.paginas.length} ${sel.paginas.length === 1 ? 'página' : 'páginas'}.`;
        if (pequenas) msg += ` ${pequenas} ${pequenas === 1 ? 'página é pequena demais e fica' : 'páginas são pequenas demais e ficam'} sem corte.`;
        if (semCorte) erro = true;
      }
    } else {
      msg = `Cada uma das ${sel.paginas.length} páginas escolhidas vai ser cortada rente ao conteúdo, com ${folga.value || 0} mm de folga.`;
      if (sel.paginas.length === 1) msg = `A página vai ser cortada rente ao conteúdo, com ${folga.value || 0} mm de folga.`;
      if (analises.get(atual) === null) msg += ' Esta página está em branco e fica como está.';
    }
    resumo.textContent = msg;
    resumo.className = erro && !msg.startsWith('Arraste') ? 'erro' : 'muted';
    botao.disabled = !dados || erro || !sel.paginas.length;
  }

  const fmt = (n: number) => n.toLocaleString('pt-BR', { maximumFractionDigits: 1 });

  function mudou() {
    camposManual.hidden = modo() !== 'manual';
    camposAuto.hidden = modo() !== 'auto';
    limparSaida();
    atualizarResumo();
    atualizarMiniaturas();
    desenharCaixa();
  }

  function definirRecorte(r: Retangulo) {
    const inf = infos[atual - 1];
    margens = recorteParaMargens(r, inf.largura, inf.altura);
    mostrarMargens();
    mudou();
  }

  function limparSaida() {
    saida.hidden = true;
    if (url) { URL.revokeObjectURL(url); url = ''; }
    status.textContent = '';
  }

  async function carregar(file: File) {
    const minha = ++rodada;
    limparSaida();
    aviso.hidden = true;
    painel.hidden = true;
    botao.disabled = true;
    dados = null; infos = []; base = null; analises.clear();
    fecharPdf(visor); visor = null;
    fila = filaDeTrabalho();
    if (!(file.type === 'application/pdf' || /\.pdf$/i.test(file.name))) {
      aviso.textContent = 'Este arquivo não é um PDF.'; aviso.hidden = false; return;
    }
    try {
      const bytes = await file.arrayBuffer();
      const doc = await abrirParaEditar(bytes);
      if (minha !== rodada) return;
      dados = bytes;
      infos = doc.getPages().map(infoDaPagina);
      nomeBase = file.name.replace(/\.pdf$/i, '') || 'documento';
      const n = infos.length;
      info.textContent = `${file.name} · ${n} ${n === 1 ? 'página' : 'páginas'} · ${tamanhoArquivo(file.size)}`;
      atual = 1;
      // Começa com 1 cm de margem para os cantos ficarem fáceis de pegar.
      margens = { topo: 10, base: 10, esquerda: 10, direita: 10 };
      mostrarMargens();
      tela.innerHTML = '<span class="muted">Carregando a prévia…</span>';
      caixa.hidden = true;
      painel.hidden = false;
      montarMiniaturas();
      mudou();
      const v = await abrirParaVer(bytes);
      if (minha !== rodada) { fecharPdf(v); return; }
      visor = v;
      for (const li of Array.from(grade.children)) { observador!.unobserve(li); observador!.observe(li); }
      await desenharPrevia();
    } catch (e) {
      if (minha !== rodada) return;
      aviso.textContent = e instanceof ErroPdf ? e.message : 'Não foi possível abrir este PDF.';
      aviso.hidden = false;
      painel.hidden = true;
    }
  }

  entrada.addEventListener('arquivos', (e) => carregar((e as CustomEvent<File[]>).detail[0]));
  document.querySelectorAll('input[name="modo"]').forEach((el) => el.addEventListener('change', () => { mudou(); desenharPrevia().catch(() => undefined); }));
  for (const [k, el] of Object.entries(campos) as [keyof Margens, HTMLInputElement][]) {
    el.addEventListener('input', () => {
      const v = Number(el.value);
      if (!Number.isFinite(v) || v < 0) return;
      margens = { ...margens, [k]: v };
      mudou();
    });
    el.addEventListener('change', mostrarMargens);
  }
  folga.addEventListener('input', mudou);
  paginasCampo.addEventListener('input', mudou);
  anterior.addEventListener('click', () => irPara(atual - 1));
  proxima.addEventListener('click', () => irPara(atual + 1));
  grade.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-pagina]');
    if (li) { irPara(Number(li.dataset.pagina)); palco.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }
  });

  $('inteira').addEventListener('click', () => { margens = { topo: 0, base: 0, esquerda: 0, direita: 0 }; mostrarMargens(); mudou(); });
  $('detectar').addEventListener('click', async () => {
    if (!visor) return;
    status.textContent = 'Procurando as margens…';
    const r = await fila(() => analisar(atual));
    status.textContent = r ? '' : 'Esta página parece estar em branco.';
    if (r) definirRecorte(comFolga(r, mmParaPt(3), infos[atual - 1]));
  });

  // Arrastar a moldura ou os cantos (mouse, dedo ou caneta).
  let arraste: { alca: Alca; x0: number; y0: number; r0: Retangulo; escala: number; id: number } | null = null;
  caixa.addEventListener('pointerdown', (e) => {
    if (modo() !== 'manual') return;
    const alvo = (e.target as HTMLElement).closest<HTMLElement>('[data-alca]');
    const r = recorteDaPagina(atual);
    if (!alvo || e.button > 0 || !r) return;
    e.preventDefault();
    caixa.focus({ preventScroll: true });
    const escala = infos[atual - 1].largura / palco.getBoundingClientRect().width;
    arraste = { alca: alvo.dataset.alca as Alca, x0: e.clientX, y0: e.clientY, r0: { ...r }, escala, id: e.pointerId };
    caixa.setPointerCapture(e.pointerId);
    caixa.classList.add('ativa');
  });
  caixa.addEventListener('pointermove', (e) => {
    if (!arraste || e.pointerId !== arraste.id) return;
    const inf = infos[atual - 1];
    const dx = (e.clientX - arraste.x0) * arraste.escala, dy = (e.clientY - arraste.y0) * arraste.escala;
    definirRecorte(arrastarRecorte(arraste.r0, arraste.alca, dx, dy, { largura: inf.largura, altura: inf.altura }, null, MINIMO_PT));
  });
  const soltar = (e: PointerEvent) => {
    if (!arraste || e.pointerId !== arraste.id) return;
    arraste = null;
    caixa.classList.remove('ativa');
  };
  caixa.addEventListener('pointerup', soltar);
  caixa.addEventListener('pointercancel', soltar);
  caixa.addEventListener('keydown', (e) => {
    if (modo() !== 'manual') return;
    const inf = infos[atual - 1];
    const r = recorteDaPagina(atual);
    const passo = Math.max(1, Math.round(Math.max(inf.largura, inf.altura) / 100));
    const d: Record<string, [number, number]> = { ArrowLeft: [-passo, 0], ArrowRight: [passo, 0], ArrowUp: [0, -passo], ArrowDown: [0, passo] };
    const v = d[e.key];
    if (!v || !r) return;
    e.preventDefault();
    definirRecorte(arrastarRecorte(r, e.shiftKey ? 'se' : 'mover', v[0], v[1], { largura: inf.largura, altura: inf.altura }, null, MINIMO_PT));
  });

  botao.addEventListener('click', async () => {
    if (!dados || !visor) return;
    const minha = rodada;
    botao.disabled = true;
    limparSaida();
    try {
      const sel = paginasEscolhidas().paginas;
      if (modo() === 'auto') {
        for (const [i, p] of sel.entries()) {
          status.textContent = `Analisando a página ${i + 1} de ${sel.length}…`;
          await fila(() => analisar(p));
          if (minha !== rodada) return;
        }
        atualizarMiniaturas();
      }
      status.textContent = 'Recortando…';
      const doc = await abrirParaEditar(dados);
      const paginas = doc.getPages();
      let feitas = 0;
      for (const p of sel) {
        const r = recorteDaPagina(p);
        if (!r) continue;
        const inf = infos[p - 1];
        const c = paraCaixaPdf(r, inf.caixa, inf.rotacao, inf.altura);
        const pg = paginas[p - 1];
        // A MediaBox também muda, para o tamanho novo valer em qualquer programa (alguns ignoram a CropBox).
        pg.setMediaBox(c.x, c.y, c.largura, c.altura);
        pg.setCropBox(c.x, c.y, c.largura, c.altura);
        if (pg.node.TrimBox()) pg.setTrimBox(c.x, c.y, c.largura, c.altura);
        if (pg.node.BleedBox()) pg.setBleedBox(c.x, c.y, c.largura, c.altura);
        if (pg.node.ArtBox()) pg.setArtBox(c.x, c.y, c.largura, c.altura);
        feitas++;
      }
      doc.setProducer('oquebragalho.app');
      const blob = await paraBlob(doc);
      if (minha !== rodada) return;
      url = URL.createObjectURL(blob);
      baixar.href = url;
      baixar.download = `${nomeBase}-recortado.pdf`;
      $('saida-info').textContent = `${feitas} ${feitas === 1 ? 'página recortada' : 'páginas recortadas'} · ${tamanhoArquivo(blob.size)}`;
      saida.hidden = false;
      status.textContent = feitas ? 'Pronto!' : 'Nenhuma página precisou de corte.';
    } catch {
      status.textContent = 'Não foi possível recortar o PDF. Pode faltar memória no aparelho.';
    } finally {
      atualizarResumo();
    }
  });
</script>

