  .barra { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .barra .espaco { flex: 1; }
  .barra .btn { padding: 6px 14px; font-size: 0.9rem; }
  .barra p { min-width: 0; overflow-wrap: anywhere; }
  .opcoes { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px 16px; align-items: end; }
  .marca { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; padding-block: 10px; }
  .marca input { width: 18px; height: 18px; accent-color: var(--brand); margin: 0; }
  .nota { font-size: 0.9rem; }
  .enviar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .barra-progresso { height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .barra-progresso span { display: block; height: 100%; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--suave); }
  .saida { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; animation: surgir 0.3s var(--suave); }
  .saida span { display: block; }
  .saida strong { font-size: 1.3rem; }
  .botoes { display: flex; flex-wrap: wrap; gap: 8px; }
  textarea { font: 0.95rem/1.55 var(--f-body); resize: vertical; min-height: 200px; }
  .miniaturas {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 10px;
    max-height: 520px; overflow-y: auto; overscroll-behavior: contain;
  }
  .miniaturas :global(li) { min-width: 0; animation: entrar 0.3s var(--suave) backwards; }
  @keyframes entrar { from { opacity: 0; transform: translateY(6px) scale(0.97); } }
  .miniaturas :global(button) {
    position: relative; width: 100%; display: flex; flex-direction: column; gap: 4px; padding: 6px; text-align: left;
    border: 2px solid var(--brand); border-radius: var(--radius); background: var(--surface); color: var(--fg); font: inherit; cursor: pointer;
    transition: transform 0.18s var(--mola), opacity 0.2s var(--suave);
  }
  .miniaturas :global(button:active) { transform: scale(0.96); }
  .miniaturas :global(li.desmarcada button) { opacity: 0.45; border-color: var(--line); }
  .miniaturas :global(li.atual button) { border-color: var(--link); box-shadow: 0 0 0 3px color-mix(in srgb, var(--link) 30%, transparent); }
  .miniaturas :global(.mini) { aspect-ratio: 3 / 4; display: grid; place-items: center; overflow: hidden; background: var(--bg); border-radius: 6px; }
  .miniaturas :global(.mini canvas), .miniaturas :global(.mini img) { max-width: 100%; max-height: 100%; width: auto; height: auto; display: block; box-shadow: 0 0 0 1px var(--line); object-fit: contain; }
  .miniaturas :global(.num) { font-weight: 600; font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .miniaturas :global(.det) { font-size: 0.78rem; min-height: 1.2em; }
  .miniaturas :global(.ok) { position: absolute; top: 10px; right: 10px; opacity: 0; transform: scale(0.6); transition: opacity 0.25s var(--suave), transform 0.3s var(--mola); }
  .miniaturas :global(li.feita .ok) { opacity: 1; transform: scale(1); }
</style>
