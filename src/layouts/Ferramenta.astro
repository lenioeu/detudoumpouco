---
// Molde de TODA página de ferramenta. Ordem fixa:
// trilha > título e frase > ferramenta > anúncio > como usar e texto > perguntas frequentes > relacionadas > anúncio
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import CartaoFerramenta from '../components/CartaoFerramenta.astro';
import { SITE } from '../config';
import { ferramenta, prontas, secaoPorSlug } from '../data';

export interface Pergunta { p: string; r: string; }
interface Props {
  secao: string;
  slug: string;
  /** H1 da página. Use a busca principal, ex.: "Calculadora de porcentagem". */
  titulo: string;
  /** Uma ou duas frases logo abaixo do H1. */
  subtitulo: string;
  /** Título para a aba e o Google (até ~60 caracteres). */
  tituloSeo: string;
  /** Descrição para o Google (120 a 160 caracteres). */
  descricao: string;
  passos: string[];
  perguntas: Pergunta[];
}
const { secao, slug, titulo, subtitulo, tituloSeo, descricao, passos, perguntas } = Astro.props;
const sec = secaoPorSlug(secao);
const atual = ferramenta(secao, slug);
if (!sec || !atual) throw new Error(`Ferramenta ${secao}/${slug} não está cadastrada em src/data/ferramentas/${secao}.ts`);
const relacionadas = prontas(secao).filter((f) => f.slug !== slug).slice(0, 6);
const url = new URL(atual.url, SITE.url).href;

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: titulo, url, description: descricao,
    applicationCategory: 'UtilitiesApplication', operatingSystem: 'Qualquer (navegador)', inLanguage: 'pt-BR',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: sec.nome, item: `${SITE.url}/${sec.slug}` },
    { '@type': 'ListItem', position: 3, name: titulo, item: url } ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: perguntas.map((q) => ({
    '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })) },
];
---
<Base titulo={tituloSeo} descricao={descricao} jsonLd={jsonLd}>
  <div class="container pagina">
    <nav class="trilha" aria-label="Você está em">
      <a href="/">Início</a> <span aria-hidden="true">›</span> <a href={`/${sec.slug}`}>{sec.nome}</a>
    </nav>

    <header class="cabeca">
      <h1 style={`view-transition-name:vt-${secao}-${slug}`}>{titulo}</h1>
      <p class="sub">{subtitulo}</p>
    </header>

    <section class="ferramenta" aria-label={titulo}>
      <slot />
    </section>

    <AdSlot formato="horizontal" slot={SITE.adsenseSlots.meio ?? undefined} />

    <article class="prosa">
      <h2>Como usar</h2>
      <ol>{passos.map((p) => <li>{p}</li>)}</ol>
      <slot name="texto" />

      <h2>Perguntas frequentes</h2>
      <div class="faq">
        {perguntas.map((q) => (
          <details>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))}
      </div>
    </article>

    {relacionadas.length > 0 && (
      <section class="relacionadas">
        <h2>Outras ferramentas de {sec.nome.toLowerCase()}</h2>
        <ul>
          {relacionadas.map((f) => (
            <li><CartaoFerramenta f={f} /></li>
          ))}
        </ul>
      </section>
    )}

    <AdSlot formato="auto" slot={SITE.adsenseSlots.fim ?? undefined} />
  </div>
</Base>

<style>
  .pagina { display: flex; flex-direction: column; gap: 24px; padding-block: 20px 0; }
  .trilha { font-size: 0.9rem; color: var(--muted); }
  .trilha a { color: var(--muted); }
  .cabeca { display: flex; flex-direction: column; gap: 8px; }
  .cabeca h1 { width: fit-content; }
  .sub { color: var(--muted); font-size: 1.1rem; max-width: 60ch; }
  .ferramenta { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: clamp(16px, 3vw, 28px); box-shadow: var(--sombra); view-transition-name: ferramenta; }
  .faq { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); padding-block: 12px; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin-top: 8px; color: var(--muted); }
  .relacionadas { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }
  .relacionadas ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }
</style>
