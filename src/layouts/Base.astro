---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import { SITE } from '../config';

interface Props {
  /** Título da aba e do Google (o nome do site é acrescentado no fim). */
  titulo: string;
  /** Descrição para o Google: 120 a 160 caracteres. */
  descricao: string;
  /** Dados estruturados (schema.org) extras para esta página. */
  jsonLd?: object[];
}
const { titulo, descricao, jsonLd = [] } = Astro.props;
// Com build.format 'file' o caminho vem como "/pasta/pagina.html"; a URL pública não tem ".html".
const caminho = Astro.url.pathname.replace(/(index)?\.html$/, '') || '/';
const tituloCompleto = caminho === '/' ? `${SITE.nome}: ${SITE.slogan}` : `${titulo} | ${SITE.nome}`;
const canonica = new URL(caminho, SITE.url).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffc42e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="pt_BR" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    {SITE.adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
    )}
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <AvisoCookies />
  </body>
</html>
